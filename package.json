{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "steamspy:download": "node scripts/download-steamspy.mjs",
    "steamspy:build-static": "node scripts/build-steamspy-static.mjs",
    "catalog:build-content-exclusions": "node scripts/build-content-exclusions.mjs",
    "catalog:test-content-policy": "node --test scripts/catalog-content-policy.test.mjs",
    "test:storefront-recovery": "node --experimental-strip-types --test tests/storefront-recommendation-workflow.test.mjs",
    "db:generate": "drizzle-kit generate",
    "catalog:profile": "node scripts/import-steam-catalog.mjs --profile",
    "catalog:build-import": "node scripts/import-steam-catalog.mjs",
    "catalog:split-import": "node scripts/split-d1-import.mjs"
  },
  "dependencies": {
    "arquero": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "plotly.js-dist-min": "^4.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stream-json": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/stream-json": "^1.7.8",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
